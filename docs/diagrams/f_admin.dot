digraph F { graph [fontname="Nunito", rankdir=TB, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.32]; node [fontname="Nunito", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#1E8E4E", penwidth=1.3, shape=box]; edge [fontname="Nunito", fontsize=9, color="#546E7A", arrowsize=0.7];
 s [label="Start", shape=oval, fillcolor="#1E8E4E", fontcolor=white]; log [label="Admin logs in\n(pre-configured account)"]; tab [label="Choose section", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 ov [label="Overview: students, activity,\ntotals, category chart"]; us [label="Students: search, view details"]; ua [label="Deactivate / activate\nor delete (confirm first)", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"];
 co [label="Content: add / edit / hide /\ndelete learning lessons", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"]; sq [label="Support: open a query"]; rp [label="Write response,\nset status", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"];
 nt [label="Save reply\nNotify student in-app"]; se [label="Settings: chatbot on/off,\ndefault alert threshold, support email,\nexport analytics CSV", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"];
 e [label="Log out", shape=oval, fillcolor="#1E8E4E", fontcolor=white];
 s -> log -> tab; tab -> ov [label="Overview"]; tab -> us [label="Students"]; tab -> co [label="Content"]; tab -> sq [label="Support"]; tab -> se [label="Settings"];
 us -> ua; sq -> rp -> nt; {ov ua co nt se} -> e;
}
