digraph F { graph [fontname="Nunito", rankdir=TB, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.32]; node [fontname="Nunito", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#1E8E4E", penwidth=1.3, shape=box]; edge [fontname="Nunito", fontsize=9, color="#546E7A", arrowsize=0.7];
 s [label="Start", shape=oval, fillcolor="#1E8E4E", fontcolor=white]; open [label="Open PennyPal"]; sess [label="Saved session\nfor an active user?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 choice [label="Has an account?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 regin [label="Enter name, email, mobile,\npassword, confirm password", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"]; rv [label="All fields valid?\n(email format, 7-15 digit mobile,\npassword rules, passwords match,\nprivacy notice accepted)", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 rerr [label="Show error under\neach invalid field"]; dup [label="Email already\nregistered?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; derr [label="Show \"account already exists\""];
 save [label="Hash password (PBKDF2 + salt)\nSave Users + UserProfiles\nCreate welcome notification"];
 login [label="Enter email and password", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"]; lv [label="Credentials match?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; lerr [label="Show \"Incorrect email\nor password\""];
 act [label="Account active?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; aerr [label="Show \"account deactivated\""];
 upd [label="Update LastLogin\nSave session"]; role [label="Role?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 stu [label="Student dashboard"]; adm [label="Admin portal"]; e [label="End", shape=oval, fillcolor="#1E8E4E", fontcolor=white];
 s -> open -> sess; sess -> role [label="yes"]; sess -> choice [label="no"];
 choice -> login [label="yes"]; choice -> regin [label="no"];
 regin -> rv; rv -> rerr [label="no"]; rerr -> regin; rv -> dup [label="yes"]; dup -> derr [label="yes"]; derr -> regin; dup -> save [label="no"]; save -> upd;
 login -> lv; lv -> lerr [label="no"]; lerr -> login; lv -> act [label="yes"]; act -> aerr [label="no"]; aerr -> login; act -> upd [label="yes"];
 upd -> role; role -> stu [label="student"]; role -> adm [label="admin"]; stu -> e; adm -> e;
}
