digraph F { graph [fontname="Nunito", rankdir=TB, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.32]; node [fontname="Nunito", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#1E8E4E", penwidth=1.3, shape=box]; edge [fontname="Nunito", fontsize=9, color="#546E7A", arrowsize=0.7];
 s [label="Start", shape=oval, fillcolor="#1E8E4E", fontcolor=white]; q [label="Student types a question\nor taps a suggestion", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"]; en [label="Chatbot enabled\nby admin?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; off [label="Show \"assistant unavailable\""];
 ctx [label="Build context: month income, expenses,\ntop categories, budgets, goals\n(no name, email or phone)"];
 key [label="Gemini API key\nconfigured?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; load [label="Show \"Penny is thinking...\""];
 call [label="Send question + context\nto Gemini (10 s time limit)"]; ok [label="Answer received\nin time?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 ai [label="Show AI answer\n(labelled educational only)"]; rule [label="Rule-based advisor matches intent\n(budget, saving, goals, categories,\ninvestments → decline politely)"];
 show [label="Show offline answer"]; e [label="End", shape=oval, fillcolor="#1E8E4E", fontcolor=white];
 s -> q -> en; en -> off [label="no"]; off -> e; en -> ctx [label="yes"]; ctx -> key; key -> load [label="yes"]; key -> rule [label="no"]; load -> call -> ok;
 ok -> ai [label="yes"]; ok -> rule [label="no / error"]; rule -> show; ai -> e; show -> e;
}
