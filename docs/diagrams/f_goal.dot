digraph F { graph [fontname="Nunito", rankdir=TB, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.32]; node [fontname="Nunito", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#1E8E4E", penwidth=1.3, shape=box]; edge [fontname="Nunito", fontsize=9, color="#546E7A", arrowsize=0.7];
 s [label="Start", shape=oval, fillcolor="#1E8E4E", fontcolor=white]; open [label="Goals tab → Add contribution"]; amt [label="Enter amount\n(option: also record as Savings expense)", shape=parallelogram, fillcolor="#E3F2FD", color="#1E88E5"];
 val [label="Amount valid?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; err [label="Show validation message"];
 add [label="CurrentAmount = CurrentAmount + amount\nprogress = current ÷ target"];
 ms [label="Progress passed 25 / 50 / 75%\nmilestone?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; badge [label="Mark milestone badge\nSend milestone notification"];
 done [label="Progress ≥ 100%?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; comp [label="Status = completed\nMove goal to History\nSend \"Goal completed\" notification"];
 est [label="Recalculate remaining amount and\nestimated completion\n(remaining ÷ monthly contribution)"];
 exp [label="Record Savings expense?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; tx [label="Create Savings expense\n(runs budget monitor)"];
 e [label="End", shape=oval, fillcolor="#1E8E4E", fontcolor=white];
 s -> open -> amt -> val; val -> err [label="no"]; err -> amt; val -> add [label="yes"]; add -> ms; ms -> badge [label="yes"]; ms -> done [label="no"]; badge -> done;
 done -> comp [label="yes"]; done -> est [label="no"]; comp -> exp; est -> exp; exp -> tx [label="yes"]; exp -> e [label="no"]; tx -> e;
}
