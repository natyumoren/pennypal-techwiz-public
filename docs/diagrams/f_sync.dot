digraph F { graph [fontname="Nunito", rankdir=TB, bgcolor=white, pad=0.25, nodesep=0.35, ranksep=0.32]; node [fontname="Nunito", fontsize=10, style=filled, fillcolor="#FFFFFF", color="#1E8E4E", penwidth=1.3, shape=box]; edge [fontname="Nunito", fontsize=9, color="#546E7A", arrowsize=0.7];
 s [label="Start: record saved locally", shape=oval, fillcolor="#1E8E4E", fontcolor=white]; q [label="Remove older queue entry for the\nsame record, add new entry\n(upsert or delete)"];
 cfg [label="Firebase configured\nand signed in?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; local [label="Keep entry in queue\n(app works fully offline)"];
 online [label="Device online?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; wait [label="Wait for connectivity\nchange event"];
 next [label="Take next queue entry\nfor this user (attempts < 5)"]; op [label="Operation?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"];
 up [label="Read current row\nSet Firestore document\n(fixed id → no duplicates)"]; del [label="Delete Firestore document"];
 res [label="Success?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; rm [label="Remove entry from queue"]; inc [label="Attempts + 1\n(retry later)"];
 more [label="More entries?", shape=diamond, fillcolor="#FFF8E1", color="#E08A00"]; e [label="End: status = up to date", shape=oval, fillcolor="#1E8E4E", fontcolor=white];
 s -> q -> cfg; cfg -> local [label="no"]; cfg -> online [label="yes"]; online -> wait [label="no"]; wait -> online; online -> next [label="yes"];
 next -> op; op -> up [label="upsert"]; op -> del [label="delete"]; up -> res; del -> res; res -> rm [label="yes"]; res -> inc [label="no"]; rm -> more; inc -> more;
 more -> next [label="yes"]; more -> e [label="no"];
}
